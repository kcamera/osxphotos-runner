<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kcamera.osxphotos-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>osxphotos_runner</string>
        <string>menubar</string>
        <string>__DEST__</string>
        <string>__PUBLISH_TARGET__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on crash, stay quit on a clean Quit from the menu. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <!-- Menu bar app: only makes sense in a logged-in GUI session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/osxphotos-runner/menubar.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/osxphotos-runner/menubar.err.log</string>
</dict>
</plist>
